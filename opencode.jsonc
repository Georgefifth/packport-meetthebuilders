{
  "$schema": "https://opencode.ai/config.json",
  // The builder must not be able to loosen its own gates. Edit these files by hand if you need to change them.
  "permissions": [
    { "action": "edit", "resource": "scripts/gate.py", "effect": "deny" },
    { "action": "edit", "resource": "scripts/audit_claims.py", "effect": "deny" },
    { "action": "edit", "resource": "scripts/ui_lint.py", "effect": "deny" },
    { "action": "edit", "resource": "scripts/browser/probe.mjs", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/agents/evaluator.md", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/skills/browser-verification/references/scoring.md", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      // Optional: lets the evaluator drive the browser through MCP instead of scripts.
      // Turn on with "disabled": false. scripts/browser/probe.mjs works without it.
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": true
      }
    }
  }
}
